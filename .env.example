# ── VANTERRA frontend environment configuration ─────────────────────
# Copy this file to .env and adjust as needed.

# Base URL of the VANTERRA backend (see server/). Required for AI reasoning
# and Telegram linking — the frontend has no AI or Telegram logic of its own.
VITE_API_BASE_URL=http://localhost:8787

# Which X Layer network to use: "testnet" (default, required during the
# BuildX AI Season Hackathon) or "mainnet" (for after the hackathon /
# chasing the volume-based Launch Grant). Chain IDs and public RPC URLs are
# built in — you don't need to set anything else to get real onchain reads.
VITE_XLAYER_NETWORK=testnet

# Optional override — only set this if you want a private/paid RPC provider
# instead of the public endpoint for the selected network above.
VITE_XLAYER_RPC_URL=

# Real onchain execution (optional). When both are set AND a wallet
# provider is connected, approving/depositing in the Agent's transaction
# modal submits actual signed transactions to X Layer instead of the
# simulator in services/transaction.js.
VITE_USDC_ADDRESS=
VITE_VAULT_ADDRESS=
