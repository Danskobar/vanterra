# ── VANTERRA backend configuration ──────────────────────────────────
PORT=8787

# AI provider — required for real (non-demo) AI reasoning and strategy
# extraction. Set AI_PROVIDER=anthropic to use Claude directly, or point
# AI_PROVIDER_URL at any OpenAI-compatible chat-completions endpoint.
AI_PROVIDER=anthropic
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_MODEL=claude-sonnet-4-6

# Telegram — each end user links their OWN Telegram account to their OWN
# wallet from the app; this token only identifies VANTERRA's bot.
# Create one with @BotFather, then set both values below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# X Layer RPC — used by the Telegram bot and whale watchlist to read REAL
# onchain data. Defaults to the official public TESTNET RPC if left blank
# (required during the BuildX AI Season Hackathon). Set to
# https://rpc.xlayer.tech for mainnet once you're past the hackathon stage.
XLAYER_RPC_URL=
